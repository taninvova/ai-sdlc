diff --git a/test/app.test.js b/test/app.test.js
index f7a8932..1a798bd 100644
--- a/test/app.test.js
+++ b/test/app.test.js
@@ -1 +1,14 @@
-const {test}=require('node:test');const assert=require('node:assert/strict');test('trim',()=>assert.equal(require('../app').displayLabel(' Ada '),'Ada'));
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const { displayLabel } = require("../app");
+
+test("trims ordinary names", () => {
+	assert.equal(displayLabel(" Ada "), "Ada");
+	assert.equal(displayLabel("\t Ada Lovelace \n"), "Ada Lovelace");
+});
+
+test("uses Anonymous for blank names", () => {
+	for (const name of ["   ", "\t", "\n\r", " \t\n ", ""]) {
+		assert.equal(displayLabel(name), "Anonymous", JSON.stringify(name));
+	}
+});
