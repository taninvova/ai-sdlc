diff --git a/app.js b/app.js
index 52d74ad..1bf5b0c 100644
--- a/app.js
+++ b/app.js
@@ -1 +1,4 @@
-exports.displayLabel = name => name.trim();
+exports.displayLabel = (name) => {
+	const label = name.trim();
+	return name.length > 0 && label.length === 0 ? "Anonymous" : label;
+};
diff --git a/test/app.test.js b/test/app.test.js
index f7a8932..aa12641 100644
--- a/test/app.test.js
+++ b/test/app.test.js
@@ -1 +1,25 @@
-const {test}=require('node:test');const assert=require('node:assert/strict');test('trim',()=>assert.equal(require('../app').displayLabel(' Ada '),'Ada'));
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const { displayLabel } = require("../app");
+
+test("trim", () => assert.equal(displayLabel(" Ada "), "Ada"));
+
+for (const [kind, input] of [
+	["spaces", "   "],
+	["tabs", "\t\t"],
+	["line breaks", "\r\n"],
+	["mixed whitespace", " \t\r\n "],
+	["nonbreaking spaces", "\u00a0\u00a0"],
+]) {
+	test(`AC1: ${kind} display Anonymous`, () => {
+		assert.equal(displayLabel(input), "Anonymous");
+	});
+}
+
+test("AC2: surrounding whitespace trims without removing internal spaces", () => {
+	assert.equal(displayLabel("\t Ada Lovelace \r\n"), "Ada Lovelace");
+});
+
+test("compatibility: empty input retains its existing result", () => {
+	assert.equal(displayLabel(""), "");
+});
