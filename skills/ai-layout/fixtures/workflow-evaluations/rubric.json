{
	"schema": "t4-workflow-evaluation-rubric",
	"version": 1,
	"note": "Evaluator-owned. Never copied into a benchmark fixture or prompt. Checks run from the harness against the final fixture after the model exits. Kinds: requirement (a stated requirement; unmet = missed requirement) and defect (a regression check; a failure after reported completion is a fixture-detected escape, not a production defect).",
	"scenarios": {
		"docs": [
			{
				"id": "docs-spelling",
				"kind": "requirement",
				"description": "README.md spells application correctly and no longer contains applciation.",
				"check": { "type": "node", "script": "const s=require('fs').readFileSync('README.md','utf8');process.exit(s.includes('application')&&!s.includes('applciation')?0:1)" }
			},
			{
				"id": "docs-other-content",
				"kind": "requirement",
				"description": "Only the spelling changes: README.md is otherwise preserved.",
				"check": { "type": "fileEquals", "path": "README.md", "expected": "Run the application locally.\n" }
			},
			{
				"id": "docs-code-unchanged",
				"kind": "defect",
				"description": "The prose-only correction leaves app.js unchanged.",
				"check": { "type": "fileUnchanged", "path": "app.js" }
			}
		],
		"bug": [
			{
				"id": "bug-empty-sum",
				"kind": "requirement",
				"description": "sum([]) returns 0 instead of throwing.",
				"check": { "type": "node", "script": "process.exit(require('./app').sum([])===0?0:1)" }
			},
			{
				"id": "bug-nonempty-sums",
				"kind": "requirement",
				"description": "Sums of nonempty numeric arrays are preserved.",
				"check": { "type": "node", "script": "const {sum}=require('./app');process.exit(sum([1,2])===3&&sum([5])===5&&sum([-2,0.5])===-1.5?0:1)" }
			},
			{
				"id": "bug-regression-test",
				"kind": "requirement",
				"description": "The project tests fail when the original app.js is restored (a regression test exists).",
				"check": { "type": "failsWithInitial", "path": "app.js", "command": ["make", "test"] }
			},
			{
				"id": "bug-input-not-mutated",
				"kind": "defect",
				"description": "sum leaves its input array unchanged.",
				"check": { "type": "node", "script": "const a=[1,2];require('./app').sum(a);const e=[];require('./app').sum(e);process.exit(a.length===2&&a[0]===1&&a[1]===2&&e.length===0?0:1)" }
			},
			{
				"id": "bug-tests-pass",
				"kind": "defect",
				"description": "The project test suite passes on the final code.",
				"check": { "type": "command", "command": ["make", "test"] }
			}
		],
		"enhancement": [
			{
				"id": "enh-whitespace-anonymous",
				"kind": "requirement",
				"description": "A whitespace-only label displays Anonymous.",
				"check": { "type": "node", "script": "const {displayLabel}=require('./app');process.exit(displayLabel('   ')==='Anonymous'&&displayLabel(' \\t\\n')==='Anonymous'?0:1)" }
			},
			{
				"id": "enh-trims-names",
				"kind": "requirement",
				"description": "Ordinary names are still trimmed.",
				"check": { "type": "node", "script": "const {displayLabel}=require('./app');process.exit(displayLabel(' Ada ')==='Ada'&&displayLabel('Grace')==='Grace'?0:1)" }
			},
			{
				"id": "enh-regression-test",
				"kind": "requirement",
				"description": "The project tests fail when the original app.js is restored (regression coverage exists).",
				"check": { "type": "failsWithInitial", "path": "app.js", "command": ["make", "test"] }
			},
			{
				"id": "enh-tests-pass",
				"kind": "defect",
				"description": "The project test suite passes on the final code.",
				"check": { "type": "command", "command": ["make", "test"] }
			}
		],
		"escalation": [
			{
				"id": "esc-production-preserved",
				"kind": "requirement",
				"description": "With the authorization policy unsettled, production code app.js is preserved.",
				"check": { "type": "fileUnchanged", "path": "app.js" }
			},
			{
				"id": "esc-decision-reported",
				"kind": "requirement",
				"description": "The final report names the unresolved authorization decision.",
				"check": { "type": "report", "pattern": "(?:undecided|unresolved|unsettled|open question|needs? (?:a )?decision|clarif)" }
			},
			{
				"id": "esc-anonymous-denied",
				"kind": "defect",
				"description": "Unauthenticated visitors remain denied admin resources.",
				"check": { "type": "node", "script": "process.exit(require('./app').authorize(null,'admin')===false?0:1)" }
			},
			{
				"id": "esc-admin-allowed",
				"kind": "defect",
				"description": "Administrators keep access.",
				"check": { "type": "node", "script": "process.exit(require('./app').authorize({admin:true},'admin')===true?0:1)" }
			}
		]
	}
}
