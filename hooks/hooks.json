{
  "description": "ai-sdlc logging and guard hooks. All scripts no-op unless the cwd contains an ai/ directory. None print to stdout.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/ai-hooks/scripts/session-start.js\"" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/ai-hooks/scripts/guard-paths.js\"" } ] },
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/ai-hooks/scripts/log-flush.js\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/ai-hooks/scripts/log-edit.js\"" } ] },
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/ai-hooks/scripts/log-cmd.js\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/ai-hooks/scripts/session-stop.js\"" } ] }
    ]
  }
}
